# Adresse du serveur École en ligne (sans /api/v1 à la fin).
# Sur un téléphone en développement : l'IP du poste sur le réseau local, pas localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.20:3333

# Nom de l'établissement affiché sur l'écran de connexion et le portail famille.
EXPO_PUBLIC_ETABLISSEMENT=Groupe scolaire Les Flamboyants
